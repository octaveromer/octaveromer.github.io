# Copie ce fichier en ".env" (ou définis ces variables dans ton terminal)
# Récupère ta clé sur https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : modèle Claude (par défaut claude-opus-4-8)
# Pour réduire les coûts tu peux mettre : claude-haiku-4-5
# CLAUDE_MODEL=claude-opus-4-8

# Optionnel : port du serveur (par défaut 3000)
# PORT=3000
